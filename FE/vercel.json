{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)(thocoffee|tho)(.*)"
        }
      ],
      "destination": "/tho.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)(taotao|taotaocafe)(.*)"
        }
      ],
      "destination": "/taotao.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)monari(.*)"
        }
      ],
      "destination": "/monari.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)(comga|ongbach)(.*)"
        }
      ],
      "destination": "/comga.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)emcoffee(.*)"
        }
      ],
      "destination": "/emcoffee.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)hanhuyen(.*)"
        }
