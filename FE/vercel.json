{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)(thocoffee|tho|artisan)(.*)"
        }
      ],
      "destination": "/tho.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)(taotao|taotaocafe|taotaocoffee)(.*)"
        }
      ],
      "destination": "/taotao.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)(cochin|cochincafe|cochin-cafe)(.*)"
        }
      ],
      "destination": "/cochin.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)(emcoffee|em-coffee)(.*)"
        }
      ],
      "destination": "/emcoffee.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)(hanhuyen|han-huyen|quannuochanhuyen)(.*)"
        }
      ],
      "destination": "/hanhuyen.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)(comga|ongbach|comgaongbach|comga-ongbach)(.*)"
        }
      ],
      "destination": "/comga.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)monari(.*)"
        }
      ],
      "destination": "/monari.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)(comtam|com-tam|comtamno)(.*)"
        }
      ],
      "destination": "/comtam.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)(samhouse|sam-house|samhouses)(.*)"
        }
      ],
      "destination": "/samhouse.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)(quang|monquanchat|mon-quan-chat)(.*)"
        }
      ],
      "destination": "/monquanchat.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)(hoa|hoatearoom|hoa-tea-room)(.*)"
        }
      ],
      "destination": "/hoatearoom.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
