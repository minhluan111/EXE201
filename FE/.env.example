# Domain của tenant bạn muốn test (VD: yaki.com, tamno.vn, exe-201-flax.vercel.app)
# Khi điền biến này, Frontend ở máy local sẽ tự động gửi header X-Tenant giả lập
# Đừng quên: Hãy duplicate file này và đổi tên thành .env.local
VITE_TENANT_DOMAIN=exe-201-flax.vercel.app

